# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# AI & LLM Providers
GOOGLE_GENERATIVE_AI_API_KEY=ur_google_ai_api
